type http_request_result = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type http_header = 
 record {
   name: text;
   value: text;
 };
type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: http_request_result;
 };
type StripeSessionStatus = 
 variant {
   completed: record {
                response: text;
                userPrincipal: opt text;
              };
   failed: record {error: text;};
 };
type StripeConfiguration = 
 record {
   allowedCountries: vec text;
   secretKey: text;
 };
type ShoppingItem = 
 record {
   currency: text;
   priceInCents: nat;
   productDescription: text;
   productName: text;
   quantity: nat;
 };
type ShippingAddress = 
 record {
   addressLine1: text;
   addressLine2: text;
   city: text;
   country: text;
   fullName: text;
   postalCode: text;
   state: text;
 };
type ProductInput = 
 record {
   category: text;
   description: text;
   imageBlob: opt ExternalBlob;
   isActive: bool;
   name: text;
   price: nat;
   stock: nat;
 };
type Product = 
 record {
   category: text;
   createdAt: int;
   description: text;
   id: nat;
   imageBlob: opt ExternalBlob;
   isActive: bool;
   name: text;
   price: nat;
   stock: nat;
 };
type OrderStatus = 
 variant {
   delivered;
   pending;
   shipped;
 };
type OrderItem = 
 record {
   name: text;
   price: nat;
   productId: nat;
   quantity: nat;
 };
type OrderInput = 
 record {
   customerEmail: text;
   items: vec OrderItem;
   shippingAddress: ShippingAddress;
   total: nat;
 };
type Order = 
 record {
   createdAt: int;
   customerEmail: text;
   customerId: principal;
   id: nat;
   items: vec OrderItem;
   shippingAddress: ShippingAddress;
   status: OrderStatus;
   total: nat;
 };
type ExternalBlob = blob;
type CategoryInput = 
 record {
   description: text;
   name: text;
 };
type Category = 
 record {
   description: text;
   id: nat;
   name: text;
 };
type CartItem = 
 record {
   name: text;
   price: nat;
   productId: nat;
   quantity: nat;
 };
type Cart = record {items: vec CartItem;};
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initializeAccessControl: () -> ();
  addAdmin: (user: principal) -> ();
  addToCart: (item: CartItem) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  clearCart: () -> ();
  createCategory: (input: CategoryInput) -> (Category);
  createCheckoutSession: (items: vec ShoppingItem, successUrl: text,
   cancelUrl: text) -> (text);
  createOrder: (input: OrderInput) -> (Order);
  createProduct: (input: ProductInput) -> (Product);
  deleteProduct: (id: nat) -> ();
  getAllOrders: () -> (vec Order) query;
  getCallerUserRole: () -> (UserRole) query;
  getCart: () -> (Cart) query;
  getCategories: () -> (vec Category) query;
  getCustomerOrders: () -> (vec Order) query;
  getOrder: (id: nat) -> (opt Order) query;
  getProductById: (id: nat) -> (opt Product) query;
  getProducts: () -> (vec Product) query;
  getProductsByCategory: (category: text) -> (vec Product) query;
  getStats: () -> (record {
                     totalOrders: nat;
                     totalRevenue: nat;
                   }) query;
  getStripeSessionStatus: (sessionId: text) -> (StripeSessionStatus);
  isAdmin: () -> (bool) query;
  isCallerAdmin: () -> (bool) query;
  isStripeConfigured: () -> (bool) query;
  removeAdmin: (user: principal) -> ();
  removeFromCart: (productId: nat) -> ();
  searchProducts: (term: text) -> (vec Product) query;
  setStripeConfiguration: (config: StripeConfiguration) -> ();
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  updateCartItem: (productId: nat, quantity: nat) -> ();
  updateOrderStatus: (id: nat, status: OrderStatus) -> (opt Order);
  updateProduct: (id: nat, input: ProductInput) -> (opt Product);
}
